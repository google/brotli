# Description:
#   Java port of Brotli decoder.

load("@rules_java//java:java_library.bzl", "java_library")
load(":build_defs.bzl", "brotli_java_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])  # MIT

TEST_DEPS = [
    ":dec",
    ":test_utils",
]

java_library(
    name = "core",
    srcs = [
        "BrotliError.java",
        "BrotliRuntimeException.java",
        "State.java",
        "Utils.java",
    ],
    resources = ["//:license"],
    visibility = ["//visibility:private"],
)

java_library(
    name = "dictionary_api",
    srcs = ["Dictionary.java"],
    exports = [":core"],
    deps = [":core"],
)

java_library(
    name = "dictionary_data",
    srcs = ["DictionaryData.java"],
    proguard_specs = ["proguard.pgcfg"],
    visibility = ["//visibility:private"],
    deps = [":dictionary_api"],
)

java_library(
    name = "decoder",
    srcs = [
        "BitReader.java",
        "BrotliInputStream.java",
        "Context.java",
        "Decode.java",
        "Huffman.java",
        "Transform.java",
    ],
    deps = [":dictionary_api"],
)

java_library(
    name = "dec",
    exports = [
        ":decoder",
        ":dictionary_api",
        ":dictionary_data",
    ],
)

java_library(
    name = "test_utils",
    srcs = ["TestUtils.java"],
    deps = [":dec"],
)

brotli_java_test(
    name = "BitReaderTest",
    srcs = ["BitReaderTest.java"],
    deps = TEST_DEPS,
)

brotli_java_test(
    name = "DecodeTest",
    srcs = ["DecodeTest.java"],
    test_kotlin = True,
    deps = TEST_DEPS,
)

brotli_java_test(
    name = "DictionaryTest",
    srcs = ["DictionaryTest.java"],
    deps = TEST_DEPS,
)

brotli_java_test(
    name = "EagerStreamTest",
    srcs = ["EagerStreamTest.java"],
    deps = TEST_DEPS,
)

brotli_java_test(
    name = "SynthTest",
    srcs = ["SynthTest.java"],
    test_kotlin = True,
    deps = TEST_DEPS,
)

brotli_java_test(
    name = "TransformTest",
    srcs = ["TransformTest.java"],
    deps = TEST_DEPS,
)
